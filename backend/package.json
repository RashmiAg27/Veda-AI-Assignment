{
  "name": "vedaai-backend",
  "version": "1.0.0",
  "description": "VedaAI Backend - AI Assessment Creator",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop vedaai-server",
    "logs": "pm2 logs vedaai-server"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bullmq": "^5.77.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.0",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.1.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
